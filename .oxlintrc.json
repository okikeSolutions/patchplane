{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "plugins": ["typescript", "unicorn", "import", "oxc", "effecttsgo"],
  "jsPlugins": ["./scripts/oxlint/patchplane-plugin.mjs"],
  "rules": {
    "typescript/no-floating-promises": "error",
    "effecttsgo/floating-effect": "error",
    "effecttsgo/floating-effect-in-vitest": "error",
    "effecttsgo/missing-effect-context": "error",
    "effecttsgo/missing-effect-error": "error",
    "effecttsgo/missing-return-yield-star": "error",
    "effecttsgo/class-self-mismatch": "error",
    "effecttsgo/unstable-api-usage": "off",
    "patchplane/no-unregistered-promise-boundary": "error",
    "patchplane/no-detached-effect-fork": "error",
    "patchplane/no-untraced-effect-service-method": "error",
    "patchplane/no-throw-in-effect-sync": "error",
    "patchplane/prefer-effect-pattern-matching": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "effecttsgo/strict-effect-provide": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/.alchemy/**",
    "**/node_modules/**",
    "tests/fixtures/**"
  ]
}
