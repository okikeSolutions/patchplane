{
  "name": "patchplane-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "effect-tsgo patch",
    "dev:client": "cd apps/client && bun --env-file=../../.env.local run dev",
    "dev:backend": "bun run --cwd packages/backend dev",
    "patchplane": "bun run packages/cli/src/main.ts",
    "build:client": "bun run --cwd apps/client build",
    "bundle:size:client": "bun scripts/bundle-size-client.ts",
    "bundle:check:client": "bun scripts/bundle-size-client.ts --check",
    "bench:landing-flicker": "bun scripts/landing-flicker-benchmark.ts",
    "bench:diff-viewer": "bun apps/client/src/scripts/diff-viewer-benchmark.ts",
    "infra:dev": "bun --bun alchemy dev --env-file .env.local --stage dev",
    "infra:plan": "bun --bun alchemy deploy --dry-run --env-file .env.local --stage dev",
    "infra:deploy": "bun --bun alchemy deploy --env-file .env.local --stage dev",
    "infra:destroy": "bun --bun alchemy destroy --env-file .env.local --stage dev",
    "test": "vitest run tests/architecture tests/automation --project default",
    "test:backend": "bun run --cwd packages/backend test",
    "test:domain": "bun run --cwd packages/domain test",
    "test:core": "bun run --cwd packages/core test",
    "test:plugins": "bun run --cwd packages/plugins test",
    "test:cli": "bun run --cwd packages/cli test",
    "test:client": "bun run --cwd apps/client test",
    "test:source-control": "bun run --cwd apps/source-control test",
    "test:infra": "bun run --cwd apps/infra test",
    "test:architecture": "vitest run tests/architecture --project default",
    "test:automation": "vitest run tests/automation --project default",
    "test:all": "bun run --workspaces --if-present --sequential test && bun run test",
    "check:roadmap-acceptance": "bun scripts/check-roadmap-acceptance.ts",
    "check:dead-code": "knip --no-progress --no-config-hints",
    "verify:fast": "bun run typecheck && bun run lint && bun run check:dead-code && bun run test:all && bun run eval:cli && bun run check:roadmap-acceptance",
    "verify": "bun run verify:fast && bun run build:client && bun run bundle:check:client",
    "eval:cli": "vitest run tests/evals/cli-friendliness.test.ts --project default",
    "smoke:foundation": "bun run --cwd apps/client smoke",
    "smoke:daytona-rpc": "bun --env-file=.env.local packages/plugins/src/daytona/live-rpc-smoke.ts",
    "smoke:preflight:trust-loop": "bun --env-file=.env.local apps/source-control/src/scripts/smoke-preflight-cli.ts trust-loop",
    "smoke:preflight:convex-sandbox": "bun --env-file=.env.local apps/source-control/src/scripts/smoke-preflight-cli.ts convex-sandbox",
    "smoke:browser": "bun --no-env-file apps/client/src/scripts/live-browser-acceptance.ts",
    "smoke:trust-loop": "bun --env-file=.env.local apps/source-control/src/scripts/live-trust-loop-smoke.ts",
    "smoke:convex-sandbox": "bun --env-file=.env.local apps/source-control/src/scripts/live-convex-sandbox-smoke.ts",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "lint": "oxlint --disable-nested-config && bun run --cwd packages/backend lint:convex",
    "lint:fix": "oxlint --disable-nested-config --fix && bun run --cwd packages/backend lint:convex:fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "audit": "bun audit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.2",
    "@effect/platform-node": "4.0.2",
    "alchemy": "2.0.0-beta.81",
    "effect": "4.0.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.0",
    "@effect/vitest": "4.0.2",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "knip": "6.44.1",
    "oxfmt": "^0.76.0",
    "oxlint": "1.91.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.2",
    "@effect/sql-d1": "4.0.2",
    "@effect/sql-sqlite-do": "4.0.2",
    "@hono/node-server": "2.1.3",
    "@opentelemetry/propagator-jaeger": "2.10.0",
    "glob": "14.0.3",
    "hono": "4.13.16",
    "lodash": "4.18.1",
    "minimatch": "11.0.4",
    "postcss-selector-parser": "7.1.7",
    "valibot": "1.5.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@distilled.cloud/cloudflare-runtime@0.11.3": "patches/@distilled.cloud%2Fcloudflare-runtime@0.11.3.patch",
    "@distilled.cloud/cloudflare-vite-plugin@0.11.3": "patches/@distilled.cloud%2Fcloudflare-vite-plugin@0.11.3.patch"
  }
}
