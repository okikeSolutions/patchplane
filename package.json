{
  "name": "patchplane-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check:toolchain": "bun scripts/check-toolchain.ts",
    "typecheck": "effect-tsgo tsrs@7.1.0-beta.tsrs3 --noEmit -p tsconfig.json",
    "lint": "effect-tsgo --tsrs-lint=7.1.0-beta.tsrs3 oxlint --type-aware --tsconfig tsconfig.json",
    "lint:fix": "effect-tsgo --tsrs-lint=7.1.0-beta.tsrs3 oxlint --type-aware --tsconfig tsconfig.json --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:architecture": "vitest run tests/architecture",
    "audit": "bun audit",
    "verify:fast": "bun run check:toolchain && bun run typecheck && bun run lint && bun run fmt:check && bun run test",
    "verify": "bun run verify:fast"
  },
  "dependencies": {
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.1.5",
    "@effect/tsgo": "0.73.2",
    "@effect/vitest": "4.1.5",
    "@types/bun": "1.4.4",
    "@types/node": "24.10.1",
    "oxc-parser": "0.123.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsrs": "7.1.0-beta.tsrs3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.4"
}
