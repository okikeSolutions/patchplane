    "@effect/platform-node": "4.0.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@inlang/paraglide-js": "^3.1.0",
    "@patchplane/core": "workspace:*",
    "@patchplane/domain": "workspace:*",
    "@patchplane/plugins": "workspace:*",
    "@pierre/diffs": "1.2.12",
    "@pierre/trees": "1.0.0-beta.6",
    "@sentry/core": "11.10.0",
    "@sentry/react": "11.10.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-core": "1.171.39",
    "@workos/authkit-tanstack-react-start": "0.12.0",
    "alchemy": "2.0.0-beta.81",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.49.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.68.0",
    "markdown-to-jsx": "9.10.4",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.18.0",
    "recharts": "3.10.1",
    "shiki": "4.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@inlang/plugin-m-function-matcher": "^2.4.3",
    "@inlang/plugin-message-format": "^4.6.0",
    "@tailwindcss/typography": "^0.5.20",
