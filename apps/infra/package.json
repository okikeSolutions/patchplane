{
  "name": "@patchplane/infra",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh -c 'cd ../.. && bun run infra:dev \"$@\"' --",
    "plan": "sh -c 'cd ../.. && bun run infra:plan \"$@\"' --",
    "deploy": "sh -c 'cd ../.. && bun run infra:deploy \"$@\"' --",
    "destroy": "sh -c 'cd ../.. && bun run infra:destroy \"$@\"' --",
    "test": "vitest run --config ../../vitest.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "alchemy": "2.0.0-beta.81",
    "effect": "4.0.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.2",
    "@patchplane/typescript-config": "workspace:*",
    "@types/bun": "^1.4.4",
    "vitest": "^5.1.0"
  }
}
