{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "ignorePatterns": [
    "**/dist/**",
    "**/.alchemy/**",
    "**/node_modules/**",
    "tests/fixtures/**",
    "docs/**",
    "*.md",
    ".github/FUNDING.yml",
    ".github/ISSUE_TEMPLATE/**"
  ]
}
